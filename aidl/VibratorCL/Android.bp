COMMON_CFLAGS = ["-Wall"]
COMMON_CFLAGS += ["-Werror"]

cc_library_shared {
    name: "vendor.qti.hardware.vibratorCL.impl",
    cflags: COMMON_CFLAGS,
    vendor: true,
    srcs: ["Vibrator.cpp"],
    header_libs: select(soong_config_variable("qti_vibrator", "use_libpalclient"), {
        true: [
            "libspf-headers",
            "libarosal_headers",
            "libarpal_headers",
        ],
        default: [],
    }),

    shared_libs: [
        "android.hardware.vibrator-V2-ndk",
        "libbinder_ndk",
        "liblog",
    ] + select(soong_config_variable("qti_vibrator", "use_libpalclient"), {
        true: ["libpalclient"],
        default: [],
    }),
}
